# Copy this file to ".env" and change the values for your computer.

# PostgreSQL connection
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hiring_ai

# Open-source LLM (served by Ollama on your machine or company server)
# qwen3:4b-instruct: small and fast (about 15-50 seconds per CV on a normal computer). Use the "-instruct" version:
# plain "qwen3:4b" always "thinks" first, which is much slower. llama3.1 also works but takes about 2 minutes per CV.
LLM_MODEL=qwen3:4b-instruct
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Folder where uploaded CVs are saved
UPLOAD_DIR=uploads

# Secret key that signs the sign-in tokens. Make your own long random one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Keep it private (anyone who knows it could make their own tokens). Changing it signs everybody out.
JWT_SECRET=
